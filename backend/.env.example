# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token

# Web App public URL (TWA frontendi joylashgan URL)
WEBAPP_URL=https://your-domain.example.com

# Birinchi adminning Telegram user ID (raqam). Vergul orqali ko'p admin ham yozish mumkin
ADMIN_IDS=123456789

# REST API port
PORT=3001

# SQLite ma'lumotlar bazasi yo'li (default: data/khatm.db)
DB_PATH=./data/khatm.db

# Telegram Web App initData verify uchun token (BOT_TOKEN bilan bir xil bo'ladi)
# (Maxsus o'zgartirish shart emas)
